generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  password         String         @default("")
  displayName      String?
  plan             String         @default("free")
  credits          Int            @default(0)
  googleId         String?        @unique
  appleId          String?        @unique
  apiKey           String?        @unique
  referralCode     String?        @unique
  referredBy       String?
  // Set once the referred account makes its first purchase, so a referral
  // is paid out at most once. Also set when a payout is REFUSED (self-
  // referral, cap reached), which marks it adjudicated and stops retries.
  referralCreditedAt DateTime?
  bonusCredits     Int            @default(0)
  notifyConversion Boolean        @default(true)
  notifyWeekly     Boolean        @default(false)
  notifyPromo      Boolean        @default(false)
  resetToken       String?        @unique
  resetTokenExpiry DateTime?
  // Persistent Stripe Customer. Required for promotion-code restrictions like
  // first_time_transaction, which Stripe evaluates against a customer's own
  // charge history — a per-session customer_email cannot carry that history.
  stripeCustomerId String?        @unique
  createdAt        DateTime       @default(now())
  jobs             Job[]
  subscription     Subscription?
  reviews          Review[]
  purchases        Purchase[]
}

// Local order history. Written in the same transaction as the credit grant in
// the Stripe webhook, so it is an exact record of what was actually paid for.
// Also backs the local first-purchase check (Stripe remains the authority).
model Purchase {
  id              String   @id @default(uuid())
  userId          String
  stripeSessionId String   @unique
  paymentIntentId String?
  pack            String
  credits         Int
  amountPaid      Int      // minor units (cents), as Stripe reports it
  currency        String   @default("eur")
  promoCodeUsed   String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Job {
  id         String   @id @default(uuid())
  userId     String
  inputFile  String
  outputFile String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id               String @id @default(uuid())
  userId           String @unique
  stripeCustomerId String
  plan             String
  status           String
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per Stripe webhook event we have fully processed. Written in the
// same transaction as the credit grant, so a retried event can never grant
// credits twice.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model ToolUsage {
  id        String @id @default(uuid())
  toolSlug  String @unique
  count     Int    @default(0)
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  rating    Int
  comment   String?
  language  String?
  createdAt DateTime @default(now())
  // Null until the author changes their review. Explicit rather than an
  // @updatedAt column, whose value equals createdAt on insert and so cannot
  // reliably distinguish "never edited" from "edited immediately".
  editedAt  DateTime?
  // How many times the author has changed it. The first submission is a
  // create, not an edit, so this stays 0 until the first change.
  editCount Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model ProblemReport {
  id           String   @id @default(uuid())
  message      String
  contactEmail String?
  pageUrl      String
  userAgent    String
  userId       String?
  userEmail    String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
