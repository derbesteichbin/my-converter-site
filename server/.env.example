# App
PORT=3000
CLIENT_URL=https://www.convertanyformat.com
SERVER_URL=http://localhost:8080

# CORS: extra EXACT origins allowed to make credentialed requests, comma-
# separated. Production domains, the project Vercel URLs, localhost and
# CLIENT_URL are already built in — use this only for one-off preview
# deployments. Never a wildcard: any *.vercel.app can be registered by
# anyone, and these origins may send the user's cookies.
# e.g. EXTRA_ALLOWED_ORIGINS=https://my-converter-site-git-fix-abc.vercel.app
EXTRA_ALLOWED_ORIGINS=

# Auth
JWT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Supabase PostgreSQL
DATABASE_URL=
DIRECT_URL=

# CloudConvert
CLOUDCONVERT_API_KEY=

# OpenAI (Smart Functions: TTS-1 + Whisper-1)
OPENAI_API_KEY=

# Stripe (credit packs)
STRIPE_SECRET_KEY=
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_10=
STRIPE_PRICE_30=
STRIPE_WEBHOOK_SECRET=
# Stripe coupon ID (e.g. "vYz9aBcD") for the public promo code
# CONVERTANYFORMAT2026 — create the coupon in Stripe Dashboard
# (Products → Coupons), set 50% off, then paste the ID here.
STRIPE_COUPON_ID=

# Resend (email notifications)
RESEND_API_KEY=
CONTACT_EMAIL=
# OWNER_EMAIL receives ALL owner-side notifications:
#   - new user registrations (email + Google)
#   - new credit pack purchases
#   - new business plan inquiries
#   - new user reviews
OWNER_EMAIL=moobed@convertanyformat.com
